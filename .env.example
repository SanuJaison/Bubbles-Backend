PORT=5000

MONGODB_URL=your-mongodb-connection-string

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Rotating it signs every session out.
JWT_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
# Optional; defaults to 2d.
# JWT_EXPIRES_IN=2d

# Comma-separated browser origins allowed to call the API and Socket.IO.
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Bubbles AI — any OpenAI-compatible provider works.
# OpenAI:      https://api.openai.com/v1                  gpt-4o-mini
# Groq:        https://api.groq.com/openai/v1             openai/gpt-oss-20b
# OpenRouter:  https://openrouter.ai/api/v1               openai/gpt-4o-mini
# Gemini:      https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional overrides. Groq defaults are shown below.
# AI_VISION_MODEL=qwen/qwen3.8-27b
# AI_WHISPER_MODEL=whisper-large-v3-turbo

# ── Google sign-in ──────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Add http://localhost:5173 and http://127.0.0.1:5173 to "Authorized JavaScript
# origins". The same client ID goes in frontend/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ── Account email (Nodemailer) ──────────────────────────────────────────────
# Required for new registrations, email verification, and password resets.
# Gmail example:
#   SMTP_SERVICE=gmail
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-character-google-app-password
#   SMTP_FROM=Bubbles <you@gmail.com>
# SMTP_SERVICE is optional for any other provider; set SMTP_HOST/PORT instead.
# Brevo and Resend also work through SMTP when you move to a custom domain.
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Origin used in password reset and verification links. Defaults to the first
# CLIENT_URLS entry.
# PASSWORD_RESET_URL=http://localhost:5173
# Reset links expire after this many minutes (5-120, default 30).
# PASSWORD_RESET_MINUTES=30
# Verification links expire after this many minutes (15-1440, default 1440).
# EMAIL_VERIFICATION_MINUTES=1440
# Extra comma-separated domains to block at signup/login. Common disposable
# domains are already blocked automatically.
# BLOCKED_EMAIL_DOMAINS=
